rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{sid} {
      allow read: if true;
      allow write: if request.auth != null;

      match /attendance/{studentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null || (get(/databases/$(database)/documents/sessions/$(sid)).data.status == 'open'
                      && request.resource.data.keys().hasOnly(['studentId','name','group','time','scannedAt','distance'])
                      && request.resource.data.group == get(/databases/$(database)/documents/sessions/$(sid)).data.group
                      && string(request.resource.data.studentId) == studentId);
        allow update, delete: if request.auth != null;
      }
    }

    match /devices/{d} {
      allow get: if true;
      allow list, update, delete: if request.auth != null;
      allow create: if request.resource.data.keys().hasOnly(['studentId','at']);
    }
    match /bindings/{b} {
      allow get: if true;
      allow list, update, delete: if request.auth != null;
      allow create: if request.resource.data.keys().hasOnly(['deviceId','at']);
    }
  }
}